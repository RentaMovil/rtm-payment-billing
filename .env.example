# Copia este archivo a .env (el .env nunca se sube). Lo carga application.properties.

# Base compartida rentamovil con el usuario payment_app (rtm-payment-billing-db, 03_dcl), nunca sa.
# DATABASE_PASSWORD = el parameter.paymentAppPassword de rtm-payment-billing-db/liquibase.properties
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=rentamovil;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=payment_app
DATABASE_PASSWORD=ChangeMe_PaymentApp123!

APP_PAYMENT_BILLING_PORT=3004

# iam: su clave pública se descarga sola de GET /jwks (ya no hace falta copiarla aquí).
# En Docker: http://iam:3001
IAM_URL=http://localhost:3001

# booking-reservation (monto/estado de la reserva, y destino de los eventos de este servicio).
# En Docker: http://booking-reservation:3003
BOOKING_URL=http://localhost:3003

# Cuenta de Cloudinary del frontend: solo se aceptan comprobantes y QR subidos ahí (cloudinary-account).
APP_PAYMENT_BILLING_FILE_ALLOWED_PREFIX=https://res.cloudinary.com/dz6ohgjub/image/upload/

# Carpeta donde se guardan los PDF de factura mientras no haya un api_secret de Cloudinary.
APP_PAYMENT_BILLING_INVOICE_STORAGE_DIR=./invoices-storage

# Clave compartida para llamar/validar /internal/** entre microservicios (header X-Internal-Key).
# MISMA clave en booking-reservation, fleet-maintenance, payment-billing y telemetry-gps.
APP_INTERNAL_API_KEY=ChangeMe_InternalKey123!
